# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=liverton-learn.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://liverton-learn-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=liverton-learn
VITE_FIREBASE_STORAGE_BUCKET=liverton-learn.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=694304753308
VITE_FIREBASE_APP_ID=1:694304753308:web:5ca134f5f85f428c0b0f59

# Vercel API Configuration (leave empty for same-origin production calls)
VITE_VERCEL_API_BASE_URL=

# Legacy Firebase Functions URL (deprecated; do not use for Hanna)
# VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# VITE_FIREBASE_FUNCTIONS_URL=

# Public/legacy client value. The active upload flow uses the server-signed API below.
VITE_CLOUDINARY_CLOUD_NAME=fbciycdw

# Server-only Vercel variables: never prefix these with VITE_ and never expose secrets to the browser.
# Hanna requires all four Firebase Admin/Gemini values below.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# FIREBASE_PROJECT_ID=liverton-learn
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Cloudinary signed uploads require all three values below.
# CLOUDINARY_CLOUD_NAME=fbciycdw
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CORS allowlist for the deployed frontend.
# ALLOWED_ORIGINS=https://liverton-learning.vercel.app
# RESEND_API_KEY=
