{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/send-otp", "destination": "/api/auth?action=send-otp" },
    { "source": "/api/verify-otp", "destination": "/api/auth?action=verify-otp" },
    { "source": "/api/search-users", "destination": "/api/auth?action=search-users" },
    { "source": "/api/hanna-media", "destination": "/api/hanna?action=media" },
    { "source": "/api/hanna-artifact", "destination": "/api/hanna?action=artifact" },
    { "source": "/api/hanna-research", "destination": "/api/hanna?action=research" },
    { "source": "/api/hanna/chat", "destination": "/api/hanna?action=chat" },
    { "source": "/api/hanna/search", "destination": "/api/hanna?action=search" },
    { "source": "/api/cloudinary/sign", "destination": "/api/cloudinary?action=sign" },
    { "source": "/api/courses/enroll", "destination": "/api/courses?action=enroll" },
    { "source": "/api/courses/notify-update", "destination": "/api/courses?action=notify-update" },
    { "source": "/api/flutterwave/initialize", "destination": "/api/flutterwave?action=initialize" },
    { "source": "/api/flutterwave/verify", "destination": "/api/flutterwave?action=verify" },
    { "source": "/api/notifications/dispatch", "destination": "/api/notifications?action=dispatch" },
    { "source": "/api/notifications/register-token", "destination": "/api/notifications?action=register-token" },
    {
      "source": "/((?!robots\\.txt$|sitemap\\.xml$|llms\\.txt$|manifest\\.webmanifest$|sw\\.js$|workbox-.*\\.js$|assets/.*|icons/.*|api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|llms.txt)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    }
  ]
}
